---
import { url } from '../lib/trip';

const links = [
  { href: '', label: 'Hành trình', match: (p: string) => p === '' || p.startsWith('ngay') },
  { href: 'fuji/', label: 'Fuji' },
  { href: 'an-uong/', label: 'Ăn uống' },
  { href: 'cho-o/', label: 'Chỗ ở' },
  { href: 'ngan-sach/', label: 'Ngân sách' },
  { href: 'so-tay/', label: 'Sổ tay' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/^\//, '');
const current = (l: (typeof links)[number]) => (l.match ? l.match(path) : path.startsWith(l.href));
---

<header class="nav">
  <div class="nav-in wrap">
    <a class="brand" href={url()} aria-label="Nhật Bản 2027, trang đầu">
      <span class="sun" aria-hidden="true"></span>
      <span>Nhật Bản 2027</span>
    </a>
    <nav aria-label="Mục chính">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={current(l) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: var(--glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 1px 0 var(--hair);
    view-transition-name: nav;
  }
  .nav-in {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 100%;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .brand:hover {
    text-decoration: none;
  }
  .sun {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff453a;
  }
  nav {
    margin-left: auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, transparent 0, #000 12px, #000 calc(100% - 16px), transparent);
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0 12px;
    list-style: none;
  }
  nav a {
    display: block;
    padding: 6px 10px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 13px;
    white-space: nowrap;
    transition: color 150ms, background-color 150ms;
  }
  nav a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  @media (max-width: 560px) {
    .brand span:last-child {
      display: none;
    }
    .nav-in {
      gap: 4px;
    }
    nav {
      margin-left: 0;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .nav {
      background: var(--bg);
      backdrop-filter: none;
    }
  }
</style>
