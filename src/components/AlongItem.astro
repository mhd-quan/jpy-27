---
import { fmtKm, imgSrc, type Along } from '../lib/trip';

interface Props {
  a: Along;
}
const { a } = Astro.props;
const { p, km, detour: d } = Astro.props.a;
const img = p.images[0];
const kicker = d
  ? d.km === 0
    ? d.from.onWalk
      ? 'Ngay trên đường đi bộ'
      : `Ngay cạnh ${d.from.label}`
    : d.mode === 'car'
      ? `Từ ${d.from.onWalk ? 'đường đi bộ' : d.from.label}, đi xe khoảng ${d.min} phút`
      : d.from.onWalk
        ? `Rẽ ${d.min} phút khỏi đường đi bộ`
        : `Từ ${d.from.label}, đi bộ ${d.min} phút`
  : km < 0.15
    ? 'Ngay trên đường đi'
    : `Cách đường đi ${fmtKm(km)}`;
const fee = p.fee ? `, ${p.fee.charAt(0).toLowerCase()}${p.fee.slice(1)}` : '';
---

<li data-detour={a.p.id}>
  <button type="button" class="along-item" data-place={p.id}>
    <span class="al-img">
      {img && <img src={imgSrc(img.src)} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />}
    </span>
    <span class="al-text">
      <span class="al-kicker t-micro">{kicker}{fee}</span>
      <strong>{p.name}</strong>
      {(p.note || p.why) && <span class="t-small muted al-why">{p.note ?? p.why}</span>}
    </span>
  </button>
</li>

<style>
  .along-item {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    width: 100%;
    padding: 10px;
    margin-inline: -10px;
    border: 0;
    border-radius: var(--r-m);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms;
  }
  .along-item:hover {
    background: var(--bg-2);
  }
  .along-item:active {
    transform: scale(0.99);
  }
  .al-img {
    width: 76px;
    height: 76px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-2);
  }
  .al-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .al-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .al-kicker {
    color: var(--sight);
    font-weight: 600;
  }
  .al-why {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
