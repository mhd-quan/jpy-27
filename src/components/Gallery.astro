---
import type { Img } from '../data/catalog';
import { imgSrc } from '../lib/trip';

interface Props {
  images: Img[];
  /** caption used when the photographer's caption is generic */
  dish?: string;
  name: string;
  size?: 'sm' | 'lg';
  limit?: number;
}
const { images, dish, name, size = 'sm', limit = 12 } = Astro.props;
const GENERIC = new Set(['Món ăn', 'Bên trong quán', 'Mặt tiền quán', 'Nội thất quán', '']);
const KIND_LABEL: Record<string, string> = {
  dish: 'Món',
  interior: 'Bên trong',
  exterior: 'Mặt tiền',
  room: 'Phòng',
  bath: 'Bồn tắm',
  view: 'Cảnh',
  detail: 'Chi tiết',
  other: 'Ảnh',
};
const list = images.slice(0, limit).map((im) => ({
  ...im,
  text: GENERIC.has(im.caption.trim()) ? (im.kind === 'dish' && dish ? dish : KIND_LABEL[im.kind]) : im.caption,
}));
const isTabelog = (src: string) => src.includes('tblg.k-img.com');
---

{
  list.length > 0 && (
    <div class:list={['gallery', `gallery-${size}`]} role="group" aria-label={`Ảnh ${name}`}>
      <div class="track" tabindex="0">
        {list.map((im, i) => (
          <figure class="shot" data-kind={im.kind}>
            <div class="frame">
              <img
                src={imgSrc(im.src)}
                alt={im.text}
                loading={i < 2 && size === 'lg' ? 'eager' : 'lazy'}
                decoding="async"
                referrerpolicy="no-referrer"
                width="640"
                height="480"
                onerror="this.closest('figure').remove()"
              />
            </div>
            <figcaption>
              <span class="cap">{im.text}</span>
              <span class="credit">
                {im.page ? (
                  <a href={im.page} target="_blank" rel="noopener noreferrer">
                    {isTabelog(im.src) ? `${im.credit.replace(' / Tabelog', '')} · Tabelog` : im.credit || 'Nguồn'}
                  </a>
                ) : (
                  im.credit
                )}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  )
}

<style>
  .gallery {
    --h: 168px;
    position: relative;
    margin-inline: calc(-1 * var(--bleed, 0px));
  }
  .gallery-lg {
    --h: min(56vw, 300px);
  }
  .track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--bleed, 0px);
    padding-inline: var(--bleed, 0px);
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .shot {
    flex: none;
    margin: 0;
    width: calc(var(--h) * 4 / 3);
    scroll-snap-align: start;
  }
  .frame {
    height: var(--h);
    border-radius: var(--r-m);
    overflow: hidden;
    background: var(--bg-3);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-out);
  }
  .shot:hover img {
    transform: scale(1.03);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 2px 0;
  }
  .cap {
    font-size: 14px;
    line-height: 1.3;
    letter-spacing: -0.006em;
    color: var(--ink);
  }
  .credit,
  .credit a {
    font-size: 11px;
    color: var(--ink-3);
  }
  .gallery-sm .cap {
    font-size: 13px;
  }
</style>
