---
// A ride drawn top to bottom like the line map above a train door. One rail joins the stations;
// each stretch of it takes the colour of the window worth watching (left, right, both, Fuji),
// so where a view starts and ends reads straight off the line. Notes hang off the rail where
// they start, each with a bar in the same colour.
import type { Ride, Side } from '../lib/rides';

interface Props {
  r: Ride;
}
const { r } = Astro.props;
const SIDE: Record<Side, string> = { left: 'Trái', right: 'Phải', both: 'Hai bên', front: 'Phía trước', down: 'Nhìn xuống' };
const LEFT: Side[] = ['left', 'both'];
const RIGHT: Side[] = ['right', 'both', 'front', 'down'];
/** colour of the stretch from station i to the next */
const segOf = (i: number) => {
  const on = r.events.filter((e) => e.from <= i && e.to > i);
  if (!on.length) return null;
  if (on.some((e) => e.fuji)) return 'fuji';
  const l = on.some((e) => LEFT.includes(e.side));
  const rt = on.some((e) => RIGHT.includes(e.side));
  return l && rt ? 'both' : l ? 'left' : 'right';
};
const tone = (e: Ride['events'][number]) => (e.fuji ? 'fuji' : e.side === 'both' ? 'both' : LEFT.includes(e.side) ? 'left' : 'right');
const startsAt = (i: number) => r.events.filter((e) => e.from === i);
const kmFmt = (km: number) => (km < 10 ? km.toLocaleString('vi-VN', { maximumFractionDigits: 1 }) : Math.round(km).toString());
---

<ol class="strip" aria-label={`Các ga từ ${r.fromName} tới ${r.toName}`}>
  {
    r.stations.map((s, i) => {
      const last = i === r.stations.length - 1;
      const seg = last ? null : segOf(i);
      const prevSeg = i > 0 ? segOf(i - 1) : null;
      const evs = startsAt(i);
      const tr = r.transfers.filter((t) => t.idx === i);
      const prev = r.alight && r.alight.idx === i;
      return (
        <li
          class:list={[
            'st',
            s.stop ? 'is-stop' : 'is-pass',
            last && 'is-last',
            seg && `seg-${seg}`,
            seg && seg !== prevSeg && 'seg-start',
            s.marks.map((m) => `m-${m}`),
          ]}
        >
          <span class="node" aria-hidden="true" />
          <div class="st-body">
            <p class="st-name">
              <strong>{s.en}</strong>
              {s.ja !== s.en && (
                <span class="ja" lang="ja">
                  {s.ja}
                </span>
              )}
              <span class="km tnum">{i === 0 ? 'lên tàu' : `${kmFmt(s.km)} km`}</span>
            </p>
            {i === 1 && r.hidden > 0 && <p class="t-micro faint hid">{r.hidden} ga chạy qua không hiện.</p>}
            {prev && r.alight && (
              <div class="note note-alight">
                <span class="bar" aria-hidden="true" />
                <div>
                  <p class="note-k">Chuẩn bị xuống, ga sau là {r.stations.at(-1)!.en}</p>
                  {r.alight.text && <p class="t-small">{r.alight.text}</p>}
                  {r.alight.announce && (
                    <p class="announce">
                      <span class="ja" lang="ja">
                        {r.alight.announce}
                      </span>
                      {r.alight.announceRomaji && <span class="ro">{r.alight.announceRomaji}</span>}
                      <button type="button" class="speak" data-speak={r.alight.announce} aria-label="Nghe thông báo">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                          <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
                          <path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                      </button>
                    </p>
                  )}
                </div>
              </div>
            )}
            {tr.map((t) => (
              <div class="note note-transfer">
                <span class="bar" aria-hidden="true" />
                <div>
                  <p class="note-k">Đổi tàu</p>
                  <p class="t-small">{t.text}</p>
                </div>
              </div>
            ))}
            {evs.map((e) => (
              <div class:list={['note', `tone-${tone(e)}`]}>
                <span class="bar" aria-hidden="true" />
                <div>
                  <p class="ev-k t-micro">
                    <span class="side">{SIDE[e.side]}</span>
                    {e.fuji && <span class="fuji">Fuji</span>}
                    {e.to > e.from && <span class="span">tới {r.stations[e.to].en}</span>}
                  </p>
                  <p class="t-small">{e.what}</p>
                  {e.tip && <p class="t-small muted">{e.tip}</p>}
                </div>
              </div>
            ))}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .strip {
    --rail-x: 19px;
    --rail-w: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .st {
    position: relative;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    min-height: 44px;
    padding-bottom: 14px;
  }
  /* the rail from this station's node down to the next one, coloured by the window to watch */
  .st::before {
    content: '';
    position: absolute;
    left: calc(var(--rail-x) - var(--rail-w) / 2);
    top: 10px;
    bottom: -10px;
    width: var(--rail-w);
    background: var(--rail, var(--line));
  }
  .st:first-child::before,
  .st.seg-start::before {
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
  }
  .st.is-last::before {
    display: none;
  }
  .seg-left {
    --rail: var(--side-l);
  }
  .seg-right {
    --rail: var(--side-r);
  }
  .seg-fuji {
    --rail: var(--side-f);
  }
  .seg-both {
    --rail: linear-gradient(90deg, var(--side-l) 50%, var(--side-r) 50%);
  }
  .node {
    position: relative;
    z-index: 1;
    grid-column: 1;
    justify-self: center;
    width: 14px;
    height: 14px;
    margin-top: 3px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--ink);
  }
  .is-pass .node {
    width: 8px;
    height: 8px;
    margin-top: 6px;
    border: 0;
    background: var(--ink);
    box-shadow: 0 0 0 2px var(--bg);
  }
  .m-board .node,
  .m-alight .node {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    background: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 0 0 3px var(--bg);
  }
  .m-transfer .node {
    border-color: var(--accent-bright);
  }
  .m-prev .node {
    border-color: var(--warn);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--warn) 25%, transparent);
  }
  .st-body {
    grid-column: 2;
    min-width: 0;
  }
  .st-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    margin: 0;
    line-height: 1.35;
  }
  .is-pass .st-name strong {
    font-weight: 500;
    color: var(--ink-2);
    font-size: 15px;
  }
  .st-name .ja {
    font-size: 13px;
    color: var(--ink-2);
  }
  .km {
    margin-left: auto;
    font-size: 12px;
    color: var(--ink-3);
  }
  .hid {
    margin: 4px 0 0;
  }

  /* Notes: a bar beside the text, as on the walks and shopping slots, joined to the rail by a
     short branch where the note starts */
  .note {
    --c: var(--ink-3);
    position: relative;
    display: grid;
    grid-template-columns: 4px minmax(0, 1fr);
    gap: 12px;
    margin-top: 12px;
  }
  .note::before {
    content: '';
    position: absolute;
    top: 9px;
    left: calc(var(--rail-x) - 38px + var(--rail-w) / 2);
    width: calc(38px - var(--rail-x) - var(--rail-w) / 2);
    height: 2px;
    background: var(--c);
  }
  .note .bar {
    border-radius: 2px;
    background: var(--c);
  }
  .note p {
    margin: 0;
  }
  .note p + p {
    margin-top: 3px;
  }
  .tone-left {
    --c: var(--side-l);
  }
  .tone-right {
    --c: var(--side-r);
  }
  .tone-fuji {
    --c: var(--side-f);
  }
  .tone-both {
    --c: linear-gradient(90deg, var(--side-l) 50%, var(--side-r) 50%);
  }
  .tone-both::before {
    background: var(--ink-3);
  }
  .note-alight {
    --c: var(--warn);
  }
  .note-transfer {
    --c: var(--accent-bright);
  }
  .ev-k {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 3px !important;
    font-weight: 600;
  }
  .side {
    color: var(--c);
  }
  .tone-both .side {
    color: var(--ink-2);
  }
  .fuji {
    color: var(--side-f);
  }
  .span {
    color: var(--ink-3);
    font-weight: 500;
  }
  .note-k {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 4px !important;
  }
  .note-alight .note-k {
    color: var(--warn);
  }
  .announce {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 10px;
    margin-top: 8px !important;
  }
  .announce .ja {
    font-size: 17px;
    font-weight: 600;
  }
  .ro {
    font-size: 14px;
    color: var(--accent);
  }
  .speak {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: var(--bg-2);
    color: var(--ink-2);
    cursor: pointer;
  }
  :global(.band) .speak {
    background: var(--bg);
  }
</style>
