---
import type { TripMapOptions } from '../lib/map';

interface Props {
  id: string;
  config: Omit<TripMapOptions, 'onPin'>;
  class?: string;
  label: string;
}
const { id, config, class: cls, label } = Astro.props;
---

<div class:list={['mapview', cls]} data-map-id={id} role="region" aria-label={label}>
  <div class="map-canvas" data-canvas></div>
  <script type="application/json" data-config set:html={JSON.stringify(config)} />
</div>

<script>
  const boot = async (el: HTMLElement) => {
    if (el.dataset.booted) return;
    el.dataset.booted = '1';
    const config = JSON.parse(el.querySelector('[data-config]')!.textContent!);
    const { createTripMap } = await import('../lib/map');
    const api = createTripMap(el.querySelector('[data-canvas]') as HTMLElement, {
      ...config,
      onPin: (pid: string) => window.dispatchEvent(new CustomEvent('open-place', { detail: pid })),
    });
    window.__maps ??= {};
    window.__maps[el.dataset.mapId!] = api;
    api.map.once('load', () => {
      el.classList.add('is-ready');
      window.dispatchEvent(new CustomEvent('map-ready', { detail: el.dataset.mapId }));
    });
  };

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          io.unobserve(e.target);
          boot(e.target as HTMLElement);
        }
      }
    },
    { rootMargin: '600px 0px' },
  );
  document.querySelectorAll<HTMLElement>('.mapview').forEach((el) => io.observe(el));
</script>

<style>
  .mapview {
    position: relative;
    overflow: hidden;
    background: var(--bg-2);
    isolation: isolate;
  }
  .map-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }
  .mapview.is-ready .map-canvas {
    opacity: 1;
  }
  .mapview :global(.maplibregl-ctrl-group) {
    border-radius: 12px;
    overflow: hidden;
    background: var(--glass);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: var(--shadow-1);
  }
  .mapview :global(.maplibregl-ctrl-group button + button) {
    border-top-color: var(--hair);
  }
  .mapview :global(.maplibregl-ctrl-attrib) {
    background: var(--glass);
    color: var(--ink-2);
    font-size: 10px;
  }
  .mapview :global(.maplibregl-ctrl-attrib a) {
    color: var(--ink-2);
  }
  .mapview :global(.maplibregl-cooperative-gesture-screen) {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    color: var(--ink);
    font-size: 15px;
  }
  @media (prefers-color-scheme: dark) {
    .mapview :global(.maplibregl-ctrl-group button .maplibregl-ctrl-icon) {
      filter: invert(1);
    }
  }
</style>
