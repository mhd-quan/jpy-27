---
// "Nói" — a phrase sheet that opens from any stop or ride with the scenarios that fit the place:
// pick a situation, then each line shows large Japanese, romaji to read aloud and the meaning.
// Tapping a line shows it full screen for staff; the speaker button reads it with the device's
// Japanese voice. Restaurants with a researched menu get one-tap order lines for their dishes.
import { PHRASES } from '../data/enrich.gen';
import { place, hasPlace } from '../lib/trip';

interface Props {
  /** place ids whose name and menu the sheet may need on this page */
  ids: string[];
}
const ids = [...new Set(Astro.props.ids)].filter(hasPlace);
const places = Object.fromEntries(
  ids.map((id) => {
    const p = place(id);
    return [
      id,
      {
        name: p.name,
        ja: p.ja ?? p.name,
        kind: p.kind,
        menu: (p.menu?.items ?? []).filter((m) => m.ja).map((m) => ({ ja: m.ja, romaji: m.romaji ?? '', vi: m.vi, yen: m.yen ?? null })),
      },
    ];
  }),
);
const data = { scenarios: PHRASES.scenarios, places };
---

<dialog class="sheet say-sheet" id="say-sheet" aria-label="Câu tiếng Nhật">
  <div class="panel" data-panel>
    <div class="grab" data-grab aria-hidden="true"><span></span></div>
    <button class="close" type="button" data-close aria-label="Đóng">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
    </button>
    <div class="body" data-body></div>
  </div>
</dialog>
<script type="application/json" id="say-data" set:html={JSON.stringify(data)} />

<script>
  import { initSay } from '../scripts/say';
  initSay();
</script>

<style is:global>
  .say-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 11px 0 9px;
    border: 0;
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .say-btn:hover {
    background: var(--bg-3);
    color: var(--ink);
  }
  .say-btn:active {
    transform: scale(0.96);
  }
  .say-btn svg {
    flex: none;
  }
  .band .say-btn {
    background: var(--bg);
  }

  .say-head {
    padding-right: 40px;
  }
  .say-kicker {
    margin: 6px 0 4px;
    color: var(--ink-2);
  }
  .say-head h2 {
    margin: 0;
  }
  .say-head .ja {
    margin: 4px 0 0;
    color: var(--ink-2);
  }
  .say-back {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin: 4px 0 8px -6px;
    padding: 4px 8px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--accent);
    font-size: 15px;
    cursor: pointer;
  }
  .say-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 46%), 1fr));
    gap: 8px;
    margin: 18px 0 0;
  }
  .say-scn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    min-height: 64px;
    padding: 12px 14px;
    border: 0;
    border-radius: var(--r-m);
    background: var(--bg-2);
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms, transform 120ms var(--ease-out);
  }
  .say-scn:hover {
    background: var(--bg-3);
  }
  .say-scn:active {
    transform: scale(0.98);
  }
  .say-scn strong {
    font-size: 16px;
    font-weight: 600;
  }
  .say-scn span {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .say-more {
    margin-top: 22px;
  }
  .say-more summary {
    padding: 8px 0;
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }
  .say-more summary::-webkit-details-marker {
    display: none;
  }
  .say-list {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .say-row {
    position: relative;
  }
  .say-ph {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    padding: 14px 52px 14px 16px;
    border: 0;
    border-radius: var(--r-m);
    background: var(--bg-2);
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms;
  }
  .say-ph:hover {
    background: var(--bg-3);
  }
  .say-ph .ja {
    font-size: 22px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--ink);
  }
  .say-ro {
    font-size: 15px;
    line-height: 1.35;
    color: var(--accent);
    letter-spacing: 0;
  }
  .say-vi {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .say-note {
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .say-play {
    position: absolute;
    top: 10px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink-2);
    cursor: pointer;
  }
  .say-play:active {
    transform: scale(0.94);
  }
  .say-play.is-playing {
    color: var(--accent);
  }
  .say-sub {
    margin: 26px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
    text-transform: none;
  }
  .say-menu-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 22px;
  }
  .say-menu-head .say-sub {
    margin: 0;
  }
  .say-seg {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: var(--bg-2);
  }
  .say-seg button {
    padding: 5px 12px;
    border: 0;
    border-radius: 8px;
    background: none;
    font-size: 13px;
    cursor: pointer;
  }
  .say-seg button[aria-pressed='true'] {
    background: var(--bg);
    box-shadow: var(--shadow-1);
    font-weight: 600;
  }
  .say-price {
    font-size: 13px;
    color: var(--ink-3);
  }
  .say-hear {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .say-hear li {
    padding: 12px 0;
    border-bottom: 1px solid var(--hair);
  }
  .say-hear .ja {
    font-size: 17px;
    color: var(--ink);
  }
  .say-hear .say-ro {
    display: block;
    font-size: 14px;
  }
  .say-reply {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .say-name {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .say-name input {
    flex: 1;
    min-width: 0;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
  }

  /* Full-screen card for showing staff */
  .say-show {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: max(32px, env(safe-area-inset-top)) 28px max(32px, env(safe-area-inset-bottom));
    background: var(--bg);
    animation: say-in 220ms var(--ease-out);
  }
  @keyframes say-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }
  .say-show .ja {
    font-size: clamp(34px, 9vw, 64px);
    line-height: 1.3;
    font-weight: 700;
    color: var(--ink);
    text-wrap: balance;
  }
  .say-show .say-ro {
    font-size: clamp(18px, 4.5vw, 26px);
  }
  .say-show .say-vi {
    font-size: 16px;
  }
  .say-show-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
</style>
