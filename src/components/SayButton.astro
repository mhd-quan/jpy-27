---
// Opens the phrase sheet (SayBook) with scenarios for this kind of place.
import type { Place } from '../lib/trip';

interface Props {
  tags: string[];
  place?: string;
  /** a station whose name fills the {station} template */
  station?: Pick<Place, 'name' | 'ja'>;
  scenario?: string;
  compact?: boolean;
  class?: string;
}
const { tags, place, station, scenario, compact = false, class: cls } = Astro.props;
---

<button
  type="button"
  class:list={['say-btn', compact && 'say-compact', cls]}
  data-say={tags.join(' ')}
  data-say-place={place}
  data-say-station={station?.ja ?? station?.name}
  data-say-station-ro={station?.name}
  data-say-scenario={scenario}
  aria-label="Câu tiếng Nhật cho chỗ này"
>
  <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
    <path d="M4 3.5h12a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    <text x="10" y="11.6" text-anchor="middle" font-size="7.5" font-weight="700" fill="currentColor" font-family="Hiragino Sans, Noto Sans JP, sans-serif">あ</text>
  </svg>
  {!compact && <span>Nói</span>}
</button>

<style>
  .say-compact {
    width: 30px;
    height: 30px;
    padding: 0;
    justify-content: center;
  }
</style>
