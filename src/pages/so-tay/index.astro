---
import Base from '../../layouts/Base.astro';
import { BOOKINGS, CHECKS, PASSES, PHRASES } from '../../data/trip';
import { PHRASES as BOOK } from '../../data/enrich.gen';
import { noteGroup, SCENARIO_GROUPS, STATIONS_TO_KNOW as STATIONS } from '../../data/notes';

// "22/10, 0:00" in Japan time
const jst = (iso: string) => {
  const d = new Date(new Date(iso).getTime() + 9 * 3600_000);
  return `${d.getUTCDate()}/${d.getUTCMonth() + 1}, ${d.getUTCHours()}:${String(d.getUTCMinutes()).padStart(2, '0')}`;
};

const byId = new Map(BOOK.scenarios.map((x) => [x.id, x]));
const grouped = new Set(SCENARIO_GROUPS.flatMap((g) => g.ids));
const others = BOOK.scenarios.filter((x) => !grouped.has(x.id));
const groups = [...SCENARIO_GROUPS.map((g) => ({ title: g.title, list: g.ids.flatMap((id) => (byId.has(id) ? [byId.get(id)!] : [])) })), ...(others.length ? [{ title: 'Khác', list: others }] : [])];
const phraseCount = BOOK.scenarios.reduce((t, x) => t + x.phrases.length, 0);
---

<Base title="Sổ tay" say={[]}>
  <section class="wrap hero">
    <h1 class="t-1">Sổ tay</h1>
    <p class="t-lead">Những thứ cần làm trước khi đi và cần mở nhanh trong chuyến: lịch đặt chỗ, vé, onsen, vài câu tiếng Nhật.</p>
    <nav class="seg" aria-label="Mục">
      <a href="#dat-cho">Đặt chỗ</a>
      <a href="#ve">Vé và thẻ</a>
      <a href="#hanh-ly">Hành lý, hoàn thuế</a>
      <a href="#onsen">Onsen</a>
      <a href="#tieng-nhat">Tiếng Nhật</a>
      <a href="#truoc-khi-di">Trước khi đi</a>
    </nav>
  </section>

  <section class="wrap block" id="dat-cho" aria-labelledby="b1">
    <h2 class="t-2" id="b1">Lịch đặt chỗ</h2>
    <ol class="book">
      {
        BOOKINGS.map((b) => (
          <li>
            <div class="when">
              {b.at ? (
                <time datetime={b.at} data-countdown={b.at} class="tnum">
                  {jst(b.at)} giờ Nhật
                </time>
              ) : (
                <span class="muted">{b.rule}</span>
              )}
            </div>
            <div>
              <strong>{b.title}</strong>
              {b.at && <span class="t-small muted rule">{b.rule}</span>}
              <p>{b.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="band" id="ve" aria-labelledby="b2">
    <div class="wrap block">
      <h2 class="t-2" id="b2">Vé và thẻ</h2>
      <ul class="passes">
        {
          PASSES.map((p) => (
            <li>
              <span class:list={['verdict', p.verdict === 'Mua' ? 'yes' : 'no']}>{p.verdict}</span>
              <strong>{p.name}</strong>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="prose">
        {noteGroup('ve').notes.map((n) => <p>{n.text}</p>)}
      </div>
    </div>
  </section>

  <section class="wrap block" id="hanh-ly" aria-labelledby="b3">
    <h2 class="t-2" id="b3">Hành lý và hoàn thuế</h2>
    <div class="cols">
      {
        noteGroup('hanh-ly').notes.map((n) => (
          <div>
            <h3 class="t-3">{n.title}</h3>
            <p>{n.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band" id="onsen" aria-labelledby="b4">
    <div class="wrap block">
      <h2 class="t-2" id="b4">Onsen</h2>
      <div class="cols">
        {
          noteGroup('onsen').notes.map((n) => (
            <div>
              <h3 class="t-3">{n.title}</h3>
              <p>{n.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap block" id="tieng-nhat" aria-labelledby="b5">
    <h2 class="t-2" id="b5">Tiếng Nhật</h2>
    <p class="muted lead-say">
      {BOOK.scenarios.length} tình huống, {phraseCount} câu, mỗi câu có romaji để đọc to và nút phát âm. Trong lịch từng ngày, nút <strong>Nói</strong> ở mỗi điểm dừng mở sẵn tình huống hợp với chỗ đó.
    </p>
    {
      groups.map((g) => (
        <div class="scn-group">
          <h3 class="t-small muted">{g.title}</h3>
          <div class="scn-grid">
            {g.list.map((x) => (
              <button type="button" class="scn" data-say="any" data-say-scenario={x.id}>
                <strong>{x.vi}</strong>
                <span class="t-small muted">{x.phrases.length} câu</span>
              </button>
            ))}
          </div>
        </div>
      ))
    }
    <h3 class="t-3 st-title">Câu riêng cho chuyến này</h3>
    <p class="muted">Chạm vào một câu để hiện chữ lớn cho nhân viên đọc.</p>
    <ul class="phrases">
      {
        PHRASES.map((p) => (
          <li>
            <button type="button" class="phrase" data-phrase={p.ja} data-ro={p.romaji} data-vi={p.vi}>
              <span class="t-small muted">{p.use}</span>
              <span class="ja jp" lang="ja">
                {p.ja}
              </span>
              <span class="ro">{p.romaji}</span>
              <span class="t-small">{p.vi}</span>
            </button>
          </li>
        ))
      }
    </ul>
    <h3 class="t-3 st-title">Tên ga nên nhớ</h3>
    <ul class="stations">
      {
        STATIONS.map(([vi, ja]) => (
          <li>
            <button type="button" class="phrase st" data-phrase={ja} data-ro={vi} data-vi={vi}>
              <span class="ja" lang="ja">
                {ja}
              </span>
              <span class="t-small muted">{vi}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band" id="truoc-khi-di" aria-labelledby="b6">
    <div class="wrap block">
      <h2 class="t-2" id="b6">Trước khi đi</h2>
      <dl class="checks">
        {
          CHECKS.map((c) => (
            <div>
              <dt>{c.when}</dt>
              <dd>{c.text}</dd>
            </div>
          ))
        }
      </dl>
      <div class="prose">
        {
          noteGroup('thoi-tiet').notes.map((n) => (
            <>
              <h3 class="t-3">{n.title}</h3>
              <p>{n.text}</p>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <dialog class="show" id="show-phrase" aria-label="Câu tiếng Nhật phóng to">
    <button type="button" class="show-close" data-close-show aria-label="Đóng">Xong</button>
    <p class="show-ja ja" lang="ja" data-show-ja></p>
    <p class="show-ro" data-show-ro></p>
    <p class="show-vi" data-show-vi></p>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('show-phrase') as HTMLDialogElement;
  document.querySelectorAll<HTMLButtonElement>('[data-phrase]').forEach((b) =>
    b.addEventListener('click', () => {
      dlg.querySelector('[data-show-ja]')!.textContent = b.dataset.phrase!;
      dlg.querySelector('[data-show-ro]')!.textContent = b.dataset.ro ?? '';
      dlg.querySelector('[data-show-vi]')!.textContent = b.dataset.vi!;
      dlg.showModal();
    }),
  );
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg || (e.target as HTMLElement).closest('[data-close-show]')) dlg.close();
  });

  // Countdown to booking windows (shown once the date is within a year)
  const now = Date.now();
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((t) => {
    const at = Date.parse(t.dataset.countdown!);
    const days = Math.ceil((at - now) / 86_400_000);
    if (days > 0 && days < 400) {
      const s = document.createElement('span');
      s.className = 't-small muted';
      s.textContent = ` còn ${days} ngày`;
      t.after(s);
    }
  });
</script>

<style>
  .hero {
    padding-top: clamp(40px, 7vw, 96px);
    padding-bottom: 16px;
  }
  .hero .t-lead {
    margin-top: 16px;
    max-width: 50ch;
  }
  .seg {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .seg a {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--ink);
    font-size: 15px;
  }
  .seg a:hover {
    text-decoration: none;
    background: var(--bg-3);
  }
  .block {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .block > p.muted {
    margin: 8px 0 0;
  }
  .book {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .book li {
    display: grid;
    grid-template-columns: minmax(140px, 0.6fr) 2fr;
    gap: 8px 24px;
    padding: 16px 0;
    border-top: 1px solid var(--hair);
  }
  .book .when time {
    font-weight: 600;
  }
  .book p {
    margin: 4px 0 0;
    color: var(--ink-2);
  }
  .rule {
    display: block;
  }
  @media (max-width: 640px) {
    .book li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .passes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 16px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .passes li {
    padding: 20px;
    border-radius: var(--r-l);
    background: var(--bg);
  }
  .passes p {
    margin: 6px 0 0;
    color: var(--ink-2);
    font-size: 15px;
  }
  .verdict {
    display: inline-block;
    margin-bottom: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }
  .verdict.yes {
    color: var(--good);
    background: color-mix(in srgb, var(--good) 14%, transparent);
  }
  .verdict.no {
    color: var(--ink-2);
    background: var(--bg-2);
  }
  .passes strong {
    display: block;
  }
  .prose {
    max-width: 68ch;
    margin-top: 28px;
  }
  .prose p {
    margin: 0 0 14px;
  }
  .prose h3 {
    margin: 28px 0 8px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 28px 40px;
    margin-top: 28px;
  }
  .cols p {
    margin: 8px 0 0;
    color: var(--ink-2);
  }
  .lead-say {
    max-width: 62ch;
  }
  .scn-group {
    margin-top: 24px;
  }
  .scn-group h3 {
    margin: 0 0 10px;
  }
  .scn-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(170px, 46%), 1fr));
    gap: 8px;
  }
  .scn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 12px 14px;
    border: 0;
    border-radius: var(--r-m);
    background: var(--bg-2);
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms, transform 120ms var(--ease-out);
  }
  .scn:hover {
    background: var(--bg-3);
  }
  .scn:active {
    transform: scale(0.98);
  }
  .ro {
    color: var(--accent);
    font-size: 15px;
  }
  .show-ro {
    margin: 0;
    color: var(--accent);
    font-size: clamp(18px, 4.5vw, 26px);
  }
  .phrases {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .phrase {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    height: 100%;
    padding: 18px;
    border: 0;
    border-radius: var(--r-l);
    background: var(--bg-2);
    text-align: left;
    cursor: pointer;
    transition: transform 120ms var(--ease-out), background-color 150ms;
  }
  .phrase:hover {
    background: var(--bg-3);
  }
  .phrase:active {
    transform: scale(0.98);
  }
  .jp {
    font-size: 20px;
    line-height: 1.45;
  }
  .st-title {
    margin-top: 40px;
  }
  .stations {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr));
    gap: 10px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .st .ja {
    font-size: 24px;
  }
  .checks {
    margin: 24px 0 0;
  }
  .checks div {
    display: grid;
    grid-template-columns: minmax(160px, 0.6fr) 2fr;
    gap: 8px 24px;
    padding: 14px 0;
    border-top: 1px solid var(--hair);
  }
  .checks dt {
    font-weight: 600;
  }
  .checks dd {
    margin: 0;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    .checks div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .show {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: max(24px, env(safe-area-inset-top)) 24px 24px;
    border: 0;
    background: var(--bg);
    color: var(--ink);
  }
  .show[open] {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .show-close {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    right: 16px;
    padding: 8px 16px;
    border: 0;
    border-radius: 999px;
    background: var(--bg-2);
    font-weight: 600;
    cursor: pointer;
  }
  .show-ja {
    margin: 0;
    max-width: 16em;
    font-size: clamp(36px, 9vw, 72px);
    line-height: 1.35;
    font-weight: 600;
  }
  .show-vi {
    margin: 24px 0 0;
    color: var(--ink-2);
    font-size: 17px;
  }
</style>
