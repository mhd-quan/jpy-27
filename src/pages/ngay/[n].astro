---
import Base from '../../layouts/Base.astro';
import DayPlan from '../../components/DayPlan.astro';
import { DAY_VIEWS, url } from '../../lib/trip';

export function getStaticPaths() {
  return DAY_VIEWS.map((v) => ({ params: { n: String(v.day.n) } }));
}

const n = Number(Astro.params.n);
const v = DAY_VIEWS[n - 1];
const { day } = v;
const prev = DAY_VIEWS[n - 2];
const next = DAY_VIEWS[n];
const sheetIds = [...v.pins.filter((p) => p.kind !== 'station').map((p) => p.id), ...(day.alt?.places ?? [])];
const sayIds = [...new Set(day.items.flatMap((i) => (i.type === 'stop' ? (i.place ? [i.place] : []) : [i.leg.to])))];
const DOW_SHORT: Record<string, string> = { 'Thứ Hai': 'T2', 'Thứ Ba': 'T3', 'Thứ Tư': 'T4', 'Thứ Năm': 'T5', 'Thứ Sáu': 'T6', 'Thứ Bảy': 'T7', 'Chủ Nhật': 'CN' };
---

<Base title={`Ngày ${n}: ${day.title}`} description={day.lead} sheets={sheetIds} say={sayIds}>
  <nav class="days-strip" aria-label="Chọn ngày">
    <ol>
      {
        DAY_VIEWS.map((d) => {
          const [, , dd] = d.day.date.split('-');
          return (
            <li>
              <a href={url(`ngay/${d.day.n}/`)} aria-current={d.day.n === n ? 'page' : undefined} aria-label={`Ngày ${d.day.n}, ${d.day.title}`}>
                <span class="ds-dow">{DOW_SHORT[d.day.dow]}</span>
                <span class="ds-d tnum">{Number(dd)}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </nav>

  <DayPlan
    v={v}
    kicker={`Ngày ${n} trên 12`}
    prev={prev && { href: url(`ngay/${prev.day.n}/`), label: `Ngày ${prev.day.n}`, title: prev.day.title }}
    next={next ? { href: url(`ngay/${next.day.n}/`), label: `Ngày ${next.day.n}`, title: next.day.title } : { href: url(''), label: 'Hết hành trình', title: 'Về trang đầu' }}
  />
</Base>

<style>
  .days-strip {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: var(--glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 1px 0 var(--hair);
  }
  .days-strip ol {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin: 0;
    padding: 6px var(--gutter);
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .days-strip ol::-webkit-scrollbar {
    display: none;
  }
  .days-strip a {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 44px;
    padding: 4px 0 5px;
    border-radius: 12px;
    color: var(--ink);
    transition: background-color 150ms;
  }
  .days-strip a:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .ds-dow {
    font-size: 11px;
    color: var(--ink-3);
    line-height: 1.2;
  }
  .ds-d {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }
  .days-strip a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }
  .days-strip a[aria-current='page'] .ds-dow {
    color: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  @media (max-width: 640px) {
    .days-strip ol {
      justify-content: flex-start;
    }
  }
</style>
